#!/bin/bash

set -xe

function main() {
    local project_dir

    if command -v fd >/dev/null 2>&1; then
        project_dir=$(fd "^.git$" $HOME/Projects --type d --hidden --prune --exec-batch dirname {} | fzf)
    else
        project_dir=$(find $HOME/Projects -type d -name ".git" -prune -print0 | xargs -0 dirname | fzf)
    fi

    local project_name=$(basename $project_dir)
 
    tmux new-session -d -s $project_name -c $project_dir
    tmux switch-client -t $project_name
}

main
